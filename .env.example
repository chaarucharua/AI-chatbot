# ─────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Database
# Local: ./data/support.db
# Cloud (Turso/Serverless): libsql://your-db-org.turso.io
# ─────────────────────────────────────────────────────────────
DATABASE_URL=./data/support.db
TURSO_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# Authentication
# IMPORTANT: Change JWT_SECRET to a random string of at least
# 32 characters before deploying. The server will refuse to
# start if this value is less than 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_32_char_minimum_string
JWT_EXPIRES_IN=24h

# ─────────────────────────────────────────────────────────────
# CORS
# Set to your frontend URL in production
# ─────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# AI Provider: gemini | ollama
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=gemini

# Google Gemini API
# Get an API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Ollama (optional local fallback)
# Run Ollama natively: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_TIMEOUT_MS=120000
OLLAMA_EMBEDDING_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# ChromaDB (vector database)
# Start with: docker run -p 8000:8000 chromadb/chroma
# or: pip install chromadb && chroma run --path ./chroma_data
# ─────────────────────────────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=novacart_knowledge

# ─────────────────────────────────────────────────────────────
# RAG Configuration
# NOTE: These values are starting points only.
# RAG_SIMILARITY_THRESHOLD must be evaluated against your
# specific knowledge base and embedding model combination.
# A value too high will cause unnecessary escalations.
# A value too low will cause grounding failures / hallucinations.
# Recommended: Run the evaluation script after ingestion.
# ─────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70
RAG_CONTEXT_MAX_TOKENS=3000

# ─────────────────────────────────────────────────────────────
# Document Ingestion
# ─────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=10

# ─────────────────────────────────────────────────────────────
# Chat Limits
# ─────────────────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=2000
CONVERSATION_CONTEXT_TURNS=6

# ─────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MIN=60
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_CHAT_WINDOW_MIN=1
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MIN=60

# ─────────────────────────────────────────────────────────────
# Logging
# LOG_LEVEL: error | warn | info | debug
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log
