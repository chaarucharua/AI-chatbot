{
  "name": "server",
  "version": "1.0.0",
  "description": "NovaCart customer support API server",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js tests/unit --runInBand --forceExit",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js tests/integration --runInBand --forceExit"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "chromadb": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
